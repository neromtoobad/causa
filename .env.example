# --- Power: Meterless Nightshift (primary AI provider) ---
# Copy both values from Nightshift -> Console (top right). The NVIDIA key lives
# in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Routing modes or pinned Nemotron-backed routes from GET /v1/models
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# --- Data: Zetaris (local install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- Runtime ---
# SAMPLE_MODE=true runs with no credentials: Zetaris answers from the recorded
# cache / local mirror and agents use their deterministic reasoning path.
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
CAUSA_CONTRACT_SECRET=change-me
